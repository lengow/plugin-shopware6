{% block lgw_catalog_select %}
    <div class="lgw-catalog-select">
        <h4>{{ salesChannel.name }}</h4>
        <sw-multi-select
                :options="options"
                :value="filter"
                :disabled="disabled"
                :placeholder="$tc('lengow-connector.connection.catalog.link_placeholder_catalog')"
                @update:value="onChange"
                @change="onChange"
        >
        </sw-multi-select>
    </div>
{% endblock %}
