{% block lgw_lockable_string_field %}
    <div>
        <sw-help-text class="lgw-help-text"
                      v-if="helpText"
                      :text="helpText"
                      :width="200"
                      tooltipPosition="right">
        </sw-help-text>
        <sw-text-field
            :copyable="false"
            :copyableTooltip="false"
            :disabled="locked"
            @update:value="handleChange($event)"
            @change="handleChange($event)"
            :placeholder="fieldPlaceholder"
            :label="fieldLabel"
            :value="newFieldContent">
        </sw-text-field>
    </div>
{% endblock %}
